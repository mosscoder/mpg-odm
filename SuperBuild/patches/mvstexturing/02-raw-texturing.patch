  * of the BSD 3-Clause license. See the LICENSE.txt file for details.
  */
 
+#include <cstdint>
+#include <fstream>
+
+#include <opencv2/core.hpp>
+#include <opencv2/imgcodecs.hpp>
+#include <opencv2/imgproc.hpp>
+
 #include <math/matrix.h>
 
 #include "texture_view.h"
 
 TEX_NAMESPACE_BEGIN
 
+namespace {
+
+cv::Mat undistort_map_x;
+cv::Mat undistort_map_y;
+
+/* Same calls as OpenSfM's undistort, so the pixels match its undistorted image files. */
+mve::ByteImage::Ptr
+load_undistorted_photo(std::string const & file) {
+    cv::Mat const photo = cv::imread(file, cv::IMREAD_UNCHANGED);
+    if (photo.empty() || photo.type() != CV_8UC3 || photo.size() != undistort_map_x.size()) {
+        std::cerr << "Cannot undistort " << file << ": it needs to be an 8-bit color image the size of the map" << std::endl;
+        std::exit(EXIT_FAILURE);
+    }
+    cv::Mat undistorted;
+    cv::remap(photo, undistorted, undistort_map_x, undistort_map_y, cv::INTER_CUBIC);
+
+    mve::ByteImage::Ptr image = mve::ByteImage::create(undistorted.cols, undistorted.rows, 3);
+    cv::Mat rgb(undistorted.rows, undistorted.cols, CV_8UC3, image->get_data_pointer());
+    cv::cvtColor(undistorted, rgb, cv::COLOR_BGR2RGB);
+    return image;
+}
+
+} // namespace
+
+void
+TextureView::set_undistort_map(std::string const & map_file) {
+    std::ifstream in(map_file.c_str(), std::ios::binary);
+    std::int32_t size[2] = {0, 0};
+    in.read(reinterpret_cast<char *>(size), sizeof(size));
+    undistort_map_x.create(size[0], size[1], CV_32FC1);
+    undistort_map_y.create(size[0], size[1], CV_32FC1);
+    std::streamsize const bytes = static_cast<std::streamsize>(size[0]) * size[1] * sizeof(float);
+    in.read(reinterpret_cast<char *>(undistort_map_x.data), bytes);
+    in.read(reinterpret_cast<char *>(undistort_map_y.data), bytes);
+    if (!in.good() || size[0] <= 0 || size[1] <= 0) {
+        std::cerr << "Could not read undistort map " << map_file << std::endl;
+        std::exit(EXIT_FAILURE);
+    }
+    /* Photos already load in parallel, as in OpenSfM's undistort. */
+    cv::setNumThreads(0);
+}
+
+bool
+TextureView::uses_undistort_map(void) {
+    return !undistort_map_x.empty();
+}
