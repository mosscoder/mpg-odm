+// Weights for 4 samples around a point x (0 to 1) past the second sample. Same kernel as
+// OpenCV's INTER_CUBIC (a = -0.75).
+static inline void cubicWeights(double x, double w[4])
+{
+    const double A = -0.75;
+    w[0] = ((A * (x + 1) - 5 * A) * (x + 1) + 8 * A) * (x + 1) - 4 * A;
+    w[1] = ((A + 2) * x - (A + 3)) * x * x + 1;
+    w[2] = ((A + 2) * (1 - x) - (A + 3)) * (1 - x) * (1 - x) + 1;
+    w[3] = 1.0 - w[0] - w[1] - w[2];
+}
